{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/matrixlab-research/thouless-benchmark/benchmark/case.schema.json",
  "title": "Thouless benchmark manifest",
  "type": "object",
  "required": ["schema_version", "lkm_snapshot_date", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "lkm_snapshot_date": {"type": "string", "format": "date"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "cases": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "gate": {
      "type": "object",
      "required": ["kind", "atol"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "atol": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "lkm": {
      "type": "object",
      "required": ["gcn_id", "package_id", "paper", "doi"],
      "properties": {
        "gcn_id": {"type": "string", "pattern": "^gcn_[0-9a-f]{16}$"},
        "package_id": {"type": "string", "pattern": "^paper:[0-9]+$"},
        "paper": {"type": "string", "minLength": 1},
        "doi": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": [
        "id",
        "track",
        "domain",
        "question",
        "model",
        "parameters",
        "observable",
        "gate",
        "backends",
        "lkm"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^(bulk|boundary|transport)_[a-z0-9_]+$"},
        "track": {"enum": ["bulk", "boundary", "transport"]},
        "domain": {"type": "string", "minLength": 1},
        "question": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "parameters": {"type": "object"},
        "observable": {"type": "string", "minLength": 1},
        "gate": {"$ref": "#/$defs/gate"},
        "backends": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["thouless", "pythtb", "kwant"]}
        },
        "not_applicable": {
          "type": "object",
          "propertyNames": {"enum": ["thouless", "pythtb", "kwant"]},
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "lkm": {"$ref": "#/$defs/lkm"}
      },
      "additionalProperties": false
    }
  }
}
